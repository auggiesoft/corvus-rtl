# Windows x64 cross-build (MinGW-w64): librtlsdr as one DLL with libusb inside, and the WinUSB installer.
FROM fedora:42
RUN dnf install -y -q mingw64-gcc mingw64-winpthreads-static make bzip2 && dnf clean all
# libusb, static (Fedora packages it as a DLL only); the release tarball, checked against its published digest
ADD --checksum=sha256:5977fc950f8d1395ccea9bd48c06b3f808fd3c2c961b44b0c2e6e29fc3a70a85 \
    https://github.com/libusb/libusb/releases/download/v1.0.29/libusb-1.0.29.tar.bz2 /tmp/
RUN cd /tmp && tar xjf libusb-1.0.29.tar.bz2 && cd libusb-1.0.29 \
 && ./configure -q --host=x86_64-w64-mingw32 --prefix=/opt/libusb --enable-static --disable-shared \
 && make -s -j"$(nproc)" && make -s install && cd / && rm -rf /tmp/libusb-1.0.29*
